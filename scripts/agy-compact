#!/usr/bin/env bash
# Wrapper executável para o compactador de contexto e mensagens do XP Kit
echo "⚠️ [DEPRECAÇÃO] 'agy-compact' está depreciado no v4. Use 'xp session compact' em seu lugar." >&2
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${REAL_SCRIPT}")" && pwd)"
python3 "${SCRIPT_DIR}/context_compactor.py" "$@"
