#!/usr/bin/env bash
# scripts/agy-memory-search
# Wrapper executável para o Motor de Busca Rápida de Memória (SQLite FTS5) do XP Kit.
set -euo pipefail

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${REAL_SCRIPT}")" && pwd)"
PYTHON_BIN="$(which python3 || echo "python3")"

exec "${PYTHON_BIN}" "${SCRIPT_DIR}/memory_search.py" "$@"
