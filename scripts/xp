#!/usr/bin/env python3
"""scripts/xp — Ponto Único de Entrada CLI do XP Multi-Agent Kit (AC-6)
Suporta os 9 subcomandos canônicos: contract, gate, flow, evolve, kit, memory, context, approve, run.
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent
SCRIPTS_DIR = Path(__file__).resolve().parent

sys.path.insert(0, str(ROOT_DIR))

from scripts.hooks.pre_tool_guard import record_approval


def main() -> int:
    if len(sys.argv) < 2:
        print("Uso: xp <contract|gate|flow|evolve|kit|memory|context|approve|run> [opções]")
        return 1

    subcmd = sys.argv[1]
    rest = sys.argv[2:]

    if subcmd == "contract":
        cmd = [sys.executable, str(SCRIPTS_DIR / "xp_contract.py")] + rest
        return subprocess.run(cmd).returncode
    elif subcmd == "gate":
        cmd = [sys.executable, str(SCRIPTS_DIR / "xp_gate.py")] + rest
        return subprocess.run(cmd).returncode
    elif subcmd == "approve":
        if not rest:
            print("Erro: Forneça o identificador da ação para aprovação: xp approve <id>")
            return 1
        action_id = rest[0]
        record_approval(action_id)
        print(f"Aprovação humana registrada com sucesso: {action_id}")
        return 0
    elif subcmd == "flow":
        flow_script = SCRIPTS_DIR / "xp_flow.py"
        if flow_script.is_file():
            return subprocess.run([sys.executable, str(flow_script)] + rest).returncode
        print("Subcomando 'flow' será plenamente ativado na Fase 3 (Grafo Mínimo).")
        return 0
    elif subcmd == "evolve":
        evolve_script = SCRIPTS_DIR / "xp_evolve.py"
        if evolve_script.is_file():
            return subprocess.run([sys.executable, str(evolve_script)] + rest).returncode
        print("Subcomando 'evolve' será ativado na Fase 6 (Auto-Melhoria).")
        return 0
    elif subcmd == "kit":
        if rest and rest[0] == "eval":
            eval_script = SCRIPTS_DIR / "xp_eval.py"
            return subprocess.run([sys.executable, str(eval_script)] + rest[1:]).returncode
        if rest and rest[0] == "pack":
            if len(rest) > 2 and rest[1] == "enable":
                pack_name = rest[2]
                pack_dir = ROOT_DIR / ".agents" / "packs" / pack_name
                if pack_dir.is_dir():
                    print(f"Pack '{pack_name}' ativado com sucesso!")
                    return 0
                print(f"Erro: Pack '{pack_name}' não encontrado em .agents/packs/")
                return 1
            elif len(rest) > 1 and rest[1] == "list":
                packs = [p.name for p in (ROOT_DIR / ".agents" / "packs").iterdir() if p.is_dir()]
                print(f"Packs disponíveis: {', '.join(sorted(packs))}")
                return 0
        if rest and rest[0] == "doctor":
            return subprocess.run([sys.executable, str(SCRIPTS_DIR / "kit_lint.py")] + rest[1:]).returncode
        kit_script = SCRIPTS_DIR / "kit_installer.py"
        return subprocess.run([sys.executable, str(kit_script)] + rest).returncode
    elif subcmd == "memory":
        if rest and rest[0] == "sync":
            summary = rest[1] if len(rest) > 1 else "Memory synchronized via xp memory sync"
            return subprocess.run([sys.executable, str(SCRIPTS_DIR / "xp_gate.py"), "--sync-memory", summary]).returncode
        mem_script = SCRIPTS_DIR / "memory_archiver.py"
        return subprocess.run([sys.executable, str(mem_script)] + rest).returncode
    elif subcmd == "context":
        ctx_script = SCRIPTS_DIR / "context_retriever.py"
        if ctx_script.is_file():
            return subprocess.run([sys.executable, str(ctx_script)] + rest).returncode
        return subprocess.run([sys.executable, str(SCRIPTS_DIR / "memory_search.py")] + rest).returncode
    elif subcmd == "run":
        run_script = SCRIPTS_DIR / "agy-run"
        if run_script.is_file():
            return subprocess.run([str(run_script)] + rest).returncode
        return subprocess.run(rest).returncode
    else:
        print(f"Subcomando desconhecido: '{subcmd}'. Opções: contract, gate, flow, evolve, kit, memory, context, approve, run.")
        return 1


if __name__ == "__main__":
    sys.exit(main())
