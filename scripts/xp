#!/usr/bin/env python3
"""scripts/xp — Ponto Único de Entrada CLI do XP Multi-Agent Kit (AC-6)
Fase 1: Suporte a contract, gate e approve. Os 9 subcomandos completos entram na Fase 2.
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent
SCRIPTS_DIR = Path(__file__).resolve().parent

sys.path.insert(0, str(ROOT_DIR))

from scripts.hooks.pre_tool_guard import record_approval


def main() -> int:
    if len(sys.argv) < 2:
        print("Uso: xp <contract|gate|approve|flow|evolve|kit|memory|context|run> [opções]")
        return 1

    subcmd = sys.argv[1]
    rest = sys.argv[2:]

    if subcmd == "contract":
        cmd = [sys.executable, str(SCRIPTS_DIR / "xp_contract.py")] + rest
        return subprocess.run(cmd).returncode
    elif subcmd == "gate":
        cmd = [sys.executable, str(SCRIPTS_DIR / "xp_gate.py")] + rest
        return subprocess.run(cmd).returncode
    elif subcmd == "approve":
        if not rest:
            print("Erro: Forneça o identificador da ação para aprovação: xp approve <id>")
            return 1
        action_id = rest[0]
        record_approval(action_id)
        print(f"Aprovação humana registrada com sucesso: {action_id}")
        return 0
    elif subcmd in ["flow", "evolve", "kit", "memory", "context", "run"]:
        print(f"Subcomando '{subcmd}' será ativado na Fase 2 da migração Thin Harness.")
        return 0
    else:
        print(f"Subcomando desconhecido: '{subcmd}'")
        return 1


if __name__ == "__main__":
    sys.exit(main())
