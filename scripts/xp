#!/usr/bin/env python3
"""scripts/xp — Ponto Único de Entrada CLI do XP Multi-Agent Kit v4 (AC-6)
Subcomandos canônicos: contract, gate, review, flow, evolve, kit, memory,
context, policy, approve, session, conformance, debt, worktree, effort,
compact, repo-map, skills-profile, run.
"""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path
from typing import Dict, List

ROOT_DIR = Path(__file__).resolve().parent.parent
SCRIPTS_DIR = Path(__file__).resolve().parent

if str(ROOT_DIR) not in sys.path:
    sys.path.insert(0, str(ROOT_DIR))

from scripts.hooks.pre_tool_guard import record_approval

DIRECT_PY_MAP: Dict[str, str] = {
    "contract": "xp_contract.py",
    "gate": "xp_gate.py",
    "flow": "xp_flow.py",
    "evolve": "xp_evolve.py",
    "context": "context_retriever.py",
    "policy": "policy_index.py",
    "session": "xp_session.py",
    "conformance": "conformance_report.py",
    "debt": "debt_tracker.py",
    "worktree": "git_worktree_manager.py",
    "effort": "agy_effort_router.py",
    "compact": "context_compactor.py",
    "repo-map": "repo_map.py",
    "skills-profile": "skill_profiles.py",
}


def _run_py(script_name: str, args: List[str]) -> int:
    script = SCRIPTS_DIR / script_name
    if not script.is_file():
        print(f"Erro: módulo '{script_name}' ausente em scripts/.", file=sys.stderr)
        return 1
    return subprocess.run([sys.executable, str(script)] + args).returncode


def main() -> int:
    if len(sys.argv) < 2:
        cmds = "|".join(["contract", "gate", "flow", "evolve", "kit", "memory", "context", "policy", "approve", "session", "conformance", "debt", "worktree", "effort", "compact", "run"])
        print(f"Uso: xp <{cmds}> [opções]")
        return 1

    subcmd = sys.argv[1]
    rest = sys.argv[2:]

    if subcmd in DIRECT_PY_MAP:
        return _run_py(DIRECT_PY_MAP[subcmd], rest)

    if subcmd == "review":
        return _run_py("xp_gate.py", ["review"] + rest)

    if subcmd == "approve":
        if not rest:
            print("Erro: Forneça o identificador da ação para aprovação: xp approve <id>")
            return 1
        action_id = rest[0]
        record_approval(action_id)
        print(f"Aprovação humana registrada com sucesso: {action_id}")
        return 0

    if subcmd == "kit":
        if rest and rest[0] == "eval":
            return _run_py("xp_eval.py", rest[1:])
        if rest and rest[0] == "components":
            return _run_py("kit_lint.py", ["components"] + rest[1:])
        if rest and rest[0] == "pack":
            packs_root = ROOT_DIR / ".agents" / "packs"
            if len(rest) > 2 and rest[1] == "enable":
                pack_name = rest[2]
                if (packs_root / pack_name).is_dir():
                    print(f"Pack '{pack_name}' ativado com sucesso!")
                    return 0
                print(f"Erro: Pack '{pack_name}' não encontrado em .agents/packs/")
                return 1
            if len(rest) > 1 and rest[1] == "list":
                packs = sorted(p.name for p in packs_root.iterdir() if p.is_dir()) if packs_root.is_dir() else []
                print(f"Packs disponíveis: {', '.join(packs)}")
                return 0
        if rest and rest[0] in ("doctor", "lint"):
            return _run_py("kit_lint.py", rest[1:])
        return _run_py("kit_installer.py", rest)

    if subcmd == "memory":
        if rest and rest[0] == "sync":
            summary = rest[1] if len(rest) > 1 else "Memory synchronized via xp memory sync"
            return _run_py("xp_gate.py", ["--sync-memory", summary])
        if rest and rest[0] == "search":
            return _run_py("memory_search.py", rest[1:])
        if rest and rest[0] in ("promote", "consolidate"):
            return _run_py("memory_store.py", rest)
        return _run_py("memory_archiver.py", rest)

    if subcmd == "run":
        run_script = SCRIPTS_DIR / "agy-run"
        if run_script.is_file():
            return subprocess.run([str(run_script)] + rest).returncode
        return subprocess.run(rest).returncode

    print(f"Subcomando desconhecido: '{subcmd}'. Execute 'xp' sem argumentos para ver as opções.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
