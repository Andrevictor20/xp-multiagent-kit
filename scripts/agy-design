#!/usr/bin/env bash
# scripts/agy-design
# Wrapper executável para o OpenDesign no XP Multi-Agent Kit.
set -euo pipefail

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${REAL_SCRIPT}")" && pwd)"
PYTHON_BIN="$(which python3 || echo "python3")"

exec "${PYTHON_BIN}" "${SCRIPT_DIR}/agy_design.py" "$@"
