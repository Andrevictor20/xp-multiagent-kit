#!/usr/bin/env python3
import sys; sys.stderr.write("⚠️ [DEPRECAÇÃO] 'agy-sanitize' está depreciado no v4. Use 'xp' em seu lugar.\n")
"""
agy-sanitize: Universal tool output sanitizer to prevent terminal flood and token waste.
Can be used as a command wrapper or in pipes:
    agy-sanitize pytest -v
    cat big_log.txt | agy-sanitize

Ordem de processamento (B4 antes do truncamento):
    1. strip de ruído de shell (banner/MOTD/ASCII art) - barato e sempre aplicável
    2. truncamento head/tail apenas se ainda exceder o orçamento de linhas
"""

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from kit_constants import (  # noqa: E402
    SANITIZE_HEAD_LINES,
    SANITIZE_TAIL_LINES,
    TOOL_OUTPUT_MAX_LINES,
)
try:
    from contrib.scripts.output_noise import clean_output, noise_stats  # noqa: E402
except ImportError:
    import importlib.util
    _guard_path = Path(__file__).resolve().parent / "hooks" / "tool-size-guard.py"
    _spec = importlib.util.spec_from_file_location("tsg", _guard_path)
    _tsg = importlib.util.module_from_spec(_spec)
    _spec.loader.exec_module(_tsg)
    clean_output, noise_stats = _tsg.clean_output, _tsg.noise_stats


def sanitize_lines(lines, max_lines, head_count, tail_count):
    total = len(lines)
    if total <= max_lines:
        return lines

    if head_count + tail_count >= total:
        head_count = max(1, total // 4)
        tail_count = max(1, total // 3)

    omitted = total - (head_count + tail_count)
    if omitted <= 0:
        return lines

    marker = f"\n[... {omitted} linhas omitidas pelo agy-sanitize para poupar tokens ...]\n"
    return lines[:head_count] + [marker] + lines[-tail_count:]


def report_noise(stats, stream):
    if stats["noise_lines"]:
        stream.write(
            f"[agy-sanitize] {stats['noise_lines']} linhas de banner removidas "
            f"({stats['saved_chars']} chars economizados)\n"
        )


def main():
    max_lines = int(os.environ.get("AGY_MAX_LINES", TOOL_OUTPUT_MAX_LINES))
    head_count = int(os.environ.get("AGY_HEAD_LINES", SANITIZE_HEAD_LINES))
    tail_count = int(os.environ.get("AGY_TAIL_LINES", SANITIZE_TAIL_LINES))

    args = sys.argv[1:]

    if len(args) >= 2 and args[0] in ("-m", "--max-lines"):
        try:
            max_lines = int(args[1])
            args = args[2:]
        except ValueError:
            pass

    exit_code = 0
    raw_text = ""

    if args:
        try:
            proc = subprocess.run(
                args,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
            )
            exit_code = proc.returncode
            raw_text = proc.stdout
        except Exception as e:
            sys.stderr.write(f"agy-sanitize execution error: {e}\n")
            sys.exit(1)
    else:
        try:
            raw_text = sys.stdin.read()
        except KeyboardInterrupt:
            sys.exit(130)

    cleaned = clean_output(raw_text)
    report_noise(noise_stats(raw_text), sys.stderr)

    sanitized = sanitize_lines(
        cleaned.splitlines(keepends=True), max_lines, head_count, tail_count
    )
    for line in sanitized:
        sys.stdout.write(line)
        if not line.endswith("\n"):
            sys.stdout.write("\n")
    sys.stdout.flush()

    sys.exit(exit_code)


if __name__ == "__main__":
    main()
