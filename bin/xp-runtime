#!/usr/bin/env node

import { spawn } from 'child_process';
import crypto from 'crypto';
import fs from 'fs';
import path from 'path';

// Config
const EVIDENCE_DIR = path.join(process.cwd(), '.agents', 'runtime', 'evidence');

// Ensure evidence dir exists
if (!fs.existsSync(EVIDENCE_DIR)) {
  fs.mkdirSync(EVIDENCE_DIR, { recursive: true });
}

// Parse args
const args = process.argv.slice(2);
if (args.length !== 1) {
  console.error("Usage: xp-runtime <target>");
  console.error("Available targets: backend, frontend, security, e2e");
  process.exit(1);
}

const targetInput = args[0];

// Command Registry
const commandRegistry = {
  'backend': { bin: 'npm', args: ['run', 'test:backend'] },
  'frontend': { bin: 'npm', args: ['run', 'test:frontend'] },
  'security': { bin: 'npm', args: ['run', 'test:security'] },
  'e2e': { bin: 'npm', args: ['run', 'test:e2e'] },
  'all': { bin: 'npm', args: ['test'] }
};

if (!commandRegistry[targetInput]) {
  console.error(`[xp-runtime] BLOCK: Target '${targetInput}' not found in Command Registry.`);
  process.exit(1);
}

const { bin, args: cmdArgs } = commandRegistry[targetInput];
const commandStr = `${bin} ${cmdArgs.join(' ')}`;

const execution_id = 'exec_' + crypto.randomBytes(8).toString('hex');
const started_at = new Date().toISOString();

// Determine workspace identity
const workspace_hash = crypto.createHash('sha256').update(process.cwd()).digest('hex').substring(0, 16);

// Extract task and target from env if any
const task_id = process.env.XP_TASK_ID || null;
// Force the target to be the one we matched
const target = targetInput;

console.log(`[xp-runtime] Starting execution: ${execution_id}`);
console.log(`[xp-runtime] Target Bound Command: ${commandStr}`);
console.log(`[xp-runtime] WARNING: Local Runtime has NO Release Authority.`);

// Environment Sanitization
// Remove custom PATH provided by Agent to prevent PATH injection
const safeEnv = { ...process.env };
// Ensure a clean path. On Windows/Linux it might differ, but generally we want to keep standard paths 
// and the local node_modules/.bin, but NOT /tmp/fake_bin or whatever the agent injected.
const systemPaths = process.env.PATH.split(path.delimiter).filter(p => !p.startsWith('/tmp') && !p.includes('fake')).join(path.delimiter);
safeEnv.PATH = systemPaths;
// Clean Node environment variables that could hijack execution
safeEnv.NODE_OPTIONS = '';
safeEnv.NODE_PATH = '';
safeEnv.LD_PRELOAD = '';
safeEnv.BASH_ENV = '';
safeEnv.ENV = '';

// Run with shell: false to prevent shell escapes (like "|| true")
const child = spawn(bin, cmdArgs, {
  shell: false,
  env: safeEnv,
  stdio: ['inherit', 'pipe', 'pipe']
});

let stdout = '';
let stderr = '';

child.stdout.on('data', (data) => {
  process.stdout.write(data);
  stdout += data.toString();
});

child.stderr.on('data', (data) => {
  process.stderr.write(data);
  stderr += data.toString();
});

child.on('error', (err) => {
  console.error(`[xp-runtime] FATAL ERROR: Failed to spawn ${bin}`, err);
  process.exit(1);
});

child.on('close', (code) => {
  const finished_at = new Date().toISOString();
  
  const evidence = {
    execution_id,
    command: commandStr,
    task_id,
    target,
    workspace_hash,
    status: 'COMPLETED',
    exit_code: code,
    stdout: stdout.substring(0, 50000), // truncate if too large
    stderr: stderr.substring(0, 50000),
    truncated: stdout.length > 50000 || stderr.length > 50000,
    started_at,
    finished_at,
    signature: 'DEV_ONLY_NO_AUTHORITY' // Release gatekeeper will ignore local JSON
  };

  const evidencePath = path.join(EVIDENCE_DIR, `${execution_id}.json`);
  fs.writeFileSync(evidencePath, JSON.stringify(evidence, null, 2));

  console.log(`[xp-runtime] Execution finished with code ${code}`);
  console.log(`[xp-runtime] Local Dev Evidence written to ${evidencePath}`);
  
  process.exit(code || 0);
});
