{
  "pre-tool-guard": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${KIT_ROOT}/scripts/hooks/pre_tool_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "tool-size-guard": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${KIT_ROOT}/scripts/hooks/tool-size-guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "smart-tool-optimizer": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${KIT_ROOT}/scripts/hooks/smart_tool_optimizer.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "dynamic-effort-router": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ${KIT_ROOT}/scripts/hooks/dynamic_effort_hook.py",
        "timeout": 5
      }
    ]
  }
}
